---
interface Props {
  size?: "header" | "footer";
}
const { size = "header" } = Astro.props;
---

<a href="/" class:list={["brand", size === "footer" && "brand-footer"]} aria-label="Compare 软件对比">
  <svg class="brand-mark" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
    <g transform="translate(0.870 1.069) scale(0.9332)">
      <path d="M24.076,7.110 A13.550,13.550 0 1 0 24.076,24.890 L18.642,20.166 A6.350,6.350 0 1 1 18.642,11.834 Z"></path>
      <rect x="25.626" y="9.600" width="2.650" height="12.800" rx="0.7"></rect>
      <rect x="29.476" y="12.475" width="2.650" height="8.150" rx="0.7"></rect>
    </g>
  </svg>
  <span class="brand-text">
    <span class="brand-en">Compare</span>
    <span class="brand-zh">软件对比</span>
  </span>
</a>
