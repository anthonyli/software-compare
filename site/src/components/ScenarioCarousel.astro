---
import T from './T.astro';
const scenes = [
{slug:'web-hosting',zh:'部署一个网站',en:'Launch a website',sub:'让你的下一个想法，真正上线。',subEn:'Give your next idea a place on the internet.',tag:'BUILD / 01',color:'#caff56',kind:'web',tools:'Cloudflare · Vercel',symbol:'↗',label:'↗ Live',file:'your-next-idea.site'},
{slug:'screen-recorders',zh:'录下精彩瞬间',en:'Capture your screen',sub:'从灵感演示，到值得分享的教程。',subEn:'From a quick walkthrough to your next great tutorial.',tag:'CREATE / 02',color:'#bcb3ff',kind:'record',tools:'OBS Studio · Screen Studio',symbol:'▶',label:'● REC',file:'capture.mov'},
