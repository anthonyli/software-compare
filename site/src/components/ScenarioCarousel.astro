{slug:'cloud-sql-databases',zh:'给数据一个家',en:'Make room for data',sub:'从第一行数据，到下一个大项目。',subEn:'From your first row to your next big project.',tag:'DEVELOP / 04',color:'#83def4',kind:'data',tools:'Turso · Neon',symbol:'≋',label:'SQL',file:'your-database'},
{slug:'image-editors',zh:'把灵感变成画面',en:'Make something visual',sub:'修图、绘画、创作，找到顺手的画笔。',subEn:'Retouch, paint and find your creative flow.',tag:'IMAGINE / 05',color:'#ffbadb',kind:'image',tools:'GIMP · Krita',symbol:'✳',label:'✳ CREATE',file:'untitled.canvas'},
{slug:'backend-as-a-service',zh:'搭好产品的后端',en:'Build behind the scenes',sub:'认证、存储与数据库，少一点重复工作。',subEn:'Auth, storage and databases. Less repetitive work.',tag:'MAKE / 06',color:'#a7ead1',kind:'backend',tools:'Supabase · Appwrite',symbol:'{ }',label:'✓ Connected',file:'your-next-app'},
