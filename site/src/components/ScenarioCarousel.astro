---
import T from './T.astro';
import ScenarioStory from './ScenarioStory.astro';
const scenes = [
{slug:'web-hosting',zh:'部署一个网站',en:'Launch a website',sub:'让你的下一个想法，真正上线。',subEn:'Give your next idea a place on the internet.',tag:'BUILD / 01',color:'#caff56',kind:'web',note:'小小想法，也有了家',noteEn:'hello, world.',tools:'Cloudflare · Vercel',label:'↗ Live',file:'your-next-idea.site'},
{slug:'screen-recorders',zh:'录下精彩瞬间',en:'Capture your screen',sub:'从灵感演示，到值得分享的教程。',subEn:'From a quick walkthrough to your next great tutorial.',tag:'CREATE / 02',color:'#bcb3ff',kind:'record',note:'这一刻，值得留住',noteEn:'a moment to keep',tools:'OBS Studio · Screen Studio',label:'● REC',file:'capture.mov'},
{slug:'transactional-email',zh:'发出第一封邮件',en:'Send your first email',sub:'验证码、产品通知，让消息准时抵达。',subEn:'Deliver sign-in codes, updates and a little delight.',tag:'CONNECT / 03',color:'#ffb791',kind:'mail',note:'带着心意，送到了',noteEn:'made it, with love',tools:'Resend · Postmark',label:'↗ Delivered',file:'hello@your-idea.com'},
{slug:'cloud-sql-databases',zh:'给数据一个家',en:'Make room for data',sub:'从第一行数据，到下一个大项目。',subEn:'From your first row to your next big project.',tag:'DEVELOP / 04',color:'#83def4',kind:'data',note:'慢慢长大，也没关系',noteEn:'room to grow',tools:'Turso · Neon',label:'SQL',file:'your-database'},
{slug:'image-editors',zh:'把灵感变成画面',en:'Make something visual',sub:'修图、绘画、创作，找到顺手的画笔。',subEn:'Retouch, paint and find your creative flow.',tag:'IMAGINE / 05',color:'#ffbadb',kind:'image',note:'不小心，画出了快乐',noteEn:'a little happy accident',tools:'GIMP · Krita',label:'✳ CREATE',file:'untitled.canvas'},
{slug:'backend-as-a-service',zh:'搭好产品的后端',en:'Build behind the scenes',sub:'认证、存储与数据库，少一点重复工作。',subEn:'Auth, storage and databases. Less repetitive work.',tag:'MAKE / 06',color:'#a7ead1',kind:'backend',note:'在一起，就搭好了',noteEn:'better together',tools:'Supabase · Appwrite',label:'✓ Connected',file:'your-next-app'},
];
---
<section class="scenario" data-scenario tabindex="0" aria-describedby="scenario-help" aria-roledescription="carousel" aria-label="探索使用场景" data-i18n="aria-label" data-zh="探索使用场景" data-en="Explore use cases">
<div class="scenario-top"><span class="eyebrow"><span class="spark">✳</span> COMPARE / PLAYGROUND</span><a href="#categories"><T zh="所有分类" en="All categories"/> ↗</a></div>
<div class="scenario-heading"><h1><T zh="今天，你想做什么？" en="What will you make today?"/></h1><p><T zh="从一个想法出发，发现刚刚好的工具。" en="Start with an idea. Find the tools to make it happen."/></p></div>
<div class="scenario-stage">
<svg class="liquid-defs" aria-hidden="true"><defs>{scenes.map((_,i)=><clipPath id={`liquid-clip-${i}`} clipPathUnits="objectBoundingBox"><path data-liquid-path={i} d="M0,0H1V1H0Z"/></clipPath>)}</defs></svg>
<svg class="liquid-rim" viewBox="0 0 1 1" preserveAspectRatio="none" aria-hidden="true"><path data-liquid-rim d=""/></svg>
{scenes.map((s,i)=><article class="scene" data-scene data-kind={s.kind} data-position={i===0?'active':'hidden'} aria-hidden={i!==0?'true':'false'} style={`--scene-color:${s.color}`}>
  <div class="scene-copy">
    <span class="scene-index">{s.tag}</span><h2><T zh={s.zh} en={s.en}/></h2>
    <p><T zh={s.sub} en={s.subEn}/></p>
    <a class="scene-link" href={`/c/${s.slug}/`} tabindex={i===0?0:-1}><T zh="发现适合的工具" en="Explore the tools"/><span>↗</span></a>
  </div>
  <div class={`scene-art art-${s.kind}`} aria-hidden="true">
    <div class="art-halo"></div><div class="art-orbit"></div>
    <div class="floating-tag"><span class="tag-dot"></span>{s.label}</div>
    <div class="art-window">
      <div class="window-bar"><i></i><i></i><i></i><span>{s.file}</span></div>
      <div class="window-content"><ScenarioStory kind={s.kind}/></div>
    </div>
    <div class="art-mini"><ScenarioStory kind={s.kind} compact/><span class="mini-caption"><T zh={s.note} en={s.noteEn}/></span></div>
    <div class="art-label">{s.tools}</div>
  </div>
</article>)}
</div>
<div class="scenario-controls"><button class="shuffle" data-shuffle><span>⤨</span><T zh="给我点灵感" en="Surprise me"/></button><div class="scene-dots">{scenes.map((s,i)=><button data-dot={i} aria-label={s.zh} data-i18n="aria-label" data-zh={s.zh} data-en={s.en} aria-pressed={i===0?'true':'false'}><span><i></i></span></button>)}</div></div><p id="scenario-help" class="scenario-help"><T zh="自动轮播 · 点击进度或左右键切换" en="Autoplay · Select a progress dot or use arrow keys"/></p><p class="scenario-status sr-only" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
const root = document.querySelector<HTMLElement>('[data-scenario]');
if (root) {
  const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-scene]'));
  const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
  const fills = dots.map(dot => dot.querySelector<HTMLElement>('i')!);
  const paths = Array.from(root.querySelectorAll<SVGPathElement>('[data-liquid-path]'));
  const rim = root.querySelector<SVGPathElement>('[data-liquid-rim]')!;
  const status = root.querySelector<HTMLElement>('.scenario-status')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const delay = 6000, duration = 1250;
  let current = -1, frame = 0, elapsed = 0;
  let lastTime: number | null = null;
  let inView = true, running = false, reducedMotion = reduced.matches;
  let cards: HTMLElement[] = [];
  let motionScale = root.clientWidth <= 800 ? .45 : 1;
  const smooth = (t: number) => t * t * (3 - 2 * t);
  const clamp = (t: number) => Math.max(0, Math.min(1, t));

  // Each card has a task-specific gesture. Mobile uses the same story with
  // shorter distances so the illustrations stay inside their small canvases.
  function pose(t: number, card: number): number[] {
    const travel = smooth(t), arc = Math.sin(Math.PI * t);
    if (card === 2) return [0, -5 * arc, 0, current === 1 ? arc * 3 : -arc * 2];
    if (card === 3) return [0, 3 * arc, 0, 0];
    const main = card === 0;
    switch (current) {
      case 0: // A little launch: the window lifts; its companion cheers.
        return main ? [0, 16 - 30 * travel, -25 + 45 * travel, -2 + 3 * travel]
          : [0, -9 * Math.sin(Math.PI * clamp((t - .3) / .7)), 0, 3 * arc];
      case 1: // A camera pan, followed by a small reaction from the recorder.
        return main ? [-22 + 44 * travel, 0, -12 + 25 * travel, 1 - 2 * travel]
          : [7 * arc, 2 * Math.sin(t * Math.PI * 3), 0, -3 * arc];
      case 2: // A delivery arc; the receiving card gives a gentle nod.
        return main ? [-22 + 38 * travel, -20 * arc, 0, -4 + 8 * travel]
          : [0, -8 * Math.sin(Math.PI * clamp((t - .5) / .5)), 0, 2 * arc];
      case 3: // Rows arrive from above and come to rest in their new home.
        return main ? [0, -20 + 32 * travel, 0, 0]
          : [0, -12 + 18 * smooth(clamp((t - .2) / .8)), 0, 1 - 2 * travel];
      case 4: // A sketchbook opens, with a brush-like sweep beside it.
        return main ? [5 * arc, -5 * arc, 0, -5 + 10 * travel]
          : [-12 + 24 * travel, -8 * arc, 0, 5 - 10 * travel];
      default: // Two modules move inward and connect.
        return main ? [-20 + 30 * travel, 0, -12 + 20 * travel, -2 + 2 * travel]
          : [20 - 30 * travel, 0, -12 + 20 * travel, 2 - 2 * travel];
    }
  }
  function renderScene() {
    const t = clamp(elapsed / delay);
    // Paused CSS animations sample this same clock. No independently running
    // SVG loop can drift away from the progress bar or keep ticking offscreen.
    const storyProgress = reducedMotion ? .72 : t;
    slides[current].style.setProperty('--scene-progress', String(storyProgress));
    slides[current].style.setProperty('--story-time', `${-storyProgress * delay}ms`);
    root!.dataset.cameraProgress = t.toFixed(4);
    fills[current].style.transform = `scaleX(${reducedMotion ? 1 : t})`;
    cards.forEach((card, i) => {
      if (reducedMotion) {
        card.style.translate = ''; card.style.rotate = '';
      } else {
        const [x, y, z, rotation] = pose(t, i);
        card.style.translate = `${x * motionScale}px ${y * motionScale}px ${z * motionScale}px`;
        card.style.rotate = `${rotation * motionScale}deg`;
      }
    });
  }

  // A smooth, continuously deforming liquid boundary. Coordinates are normalized,
  // so the same reveal covers wide, narrow and resized viewports without a canvas.
  function wavePath(radius: number, phase: number, strength: number, scene = current, rotation = 0) {
    // Deliberate families: rounded square, five-petal flower, bean, four-leaf
    // clover, scalloped bloom, and almost-round pebble (not six noisy blobs).
    const lobes=[3,5,2,4,6,1][scene];
    const seed=[.35,.8,1.1,Math.PI,0,.4][scene];
    const amplitude=[.14,.18,.24,.30,.14,.035][scene]*(strength/.14);
    const drift=phase*[.25,.22,.20,.08,.16,.12][scene];
    const aspect=root!.clientWidth/root!.clientHeight;
    const sx=Math.min(1,1/aspect),sy=Math.min(1,aspect);
    const points = Array.from({length:72}, (_,i) => {
      const a = i / 72 * Math.PI * 2;
      const family=scene===0
        ? 1/Math.pow(Math.pow(Math.abs(Math.cos(a)),6)+Math.pow(Math.abs(Math.sin(a)),6),1/6)
        : 1 + amplitude * Math.cos(a*lobes + drift+seed);
      // A traveling edge wave remains alive during the quick recoil; the
      // silhouette is never a frozen cutout waiting for a scale animation.
      const ripple=.022*Math.sin(a*9-phase*20)+.009*Math.sin(a*13+phase*14);
      const r = radius * (family+ripple);
      return [.5 + Math.cos(a+rotation)*r*sx, .48 + Math.sin(a+rotation)*r*sy];
    });
    const mid = (a:number[], b:number[]) => `${((a[0]+b[0])/2).toFixed(5)},${((a[1]+b[1])/2).toFixed(5)}`;
    let d = `M${mid(points[71],points[0])}`;
    points.forEach((p,i) => { d += `Q${p[0].toFixed(5)},${p[1].toFixed(5)} ${mid(p,points[(i+1)%72])}`; });
    return d + 'Z';
  }
  function settle() {
    slides.forEach((slide, i) => {
      slide.style.clipPath = 'none'; slide.style.opacity = '';
      slide.dataset.position = i === current ? 'active' : 'hidden';
    });
    rim.setAttribute('d', ''); root!.dataset.transitioning = 'false';
    root!.dataset.revealProgress = '1';
  }
  function renderReveal() {
    if (root!.dataset.transitioning !== 'true') return;
    const t = Math.min(1, elapsed / duration);
    if (t === 1) { settle(); return; }
    const coverRadius = Math.hypot(root!.clientWidth, root!.clientHeight) / Math.min(root!.clientWidth, root!.clientHeight) * .8;
    // Keep the existing liquid reach, quick recoil and turning release.
    const radius = t < .42 ? .015 + .305 * smooth(t / .42)
      : t < .55 ? .32 - .035 * smooth((t - .42) / .13)
      : .285 + (coverRadius - .285) * smooth((t - .55) / .45);
    const turn = smooth(clamp((t - .51) / .36)) * [.62, -.52, .7, -.65, .48, -.45][current];
    root!.dataset.revealRadius = radius.toFixed(4);
    root!.dataset.revealRotation = turn.toFixed(4);
    const d = wavePath(radius, t * 1.2, .14 - .08 * Math.max(0, (t - .8) / .2), current, turn);
    paths[current].setAttribute('d', d); rim.setAttribute('d', d);
    slides[current].style.opacity = String(Math.min(1, .6 + t * 1.6));
    rim.style.opacity = String(Math.sin(Math.PI * t) * .65);
    root!.dataset.revealProgress = t.toFixed(3);
  }
  function stopFrame() {
    cancelAnimationFrame(frame); frame = 0; lastTime = null; running = false;
  }
  function tick(now: number) {
    frame = 0;
    if (!running) return;
    if (lastTime !== null) elapsed += Math.max(0, now - lastTime);
    lastTime = now;
    if (elapsed >= delay) { show(current + 1, false); return; }
    renderScene(); renderReveal();
    frame = requestAnimationFrame(tick);
  }
  function syncPlayback() {
    if (current < 0) return;
    const now = performance.now();
    if (running && lastTime !== null) elapsed = Math.min(delay, elapsed + Math.max(0, now - lastTime));
    stopFrame();
    if (reducedMotion !== reduced.matches) {
      reducedMotion = reduced.matches;
      // A preference change establishes a fresh shared timeline on resume.
      // The static illustration is a completed, expressive story pose.
      if (!reducedMotion) elapsed = 0;
      settle();
    }
    root!.dataset.reducedMotion = String(reducedMotion);
    renderScene(); renderReveal();
    running = inView && !document.hidden && !reducedMotion;
    root!.dataset.autoplay = running ? 'running' : 'paused';
    if (running) { lastTime = now; frame = requestAnimationFrame(tick); }
  }
  function announce() {
    status.textContent = `${current + 1} / ${slides.length}: ${dots[current].getAttribute(document.documentElement.lang === 'en' ? 'data-en' : 'data-zh')}`;
  }
  function show(index: number, shouldAnnounce = true) {
    const next = (index + slides.length) % slides.length;
    // Clicking the active dot never extends the deadline or rewinds a story.
    if (next === current) return;
    const previous = current;
    if (previous >= 0 && slides[previous].contains(document.activeElement)) root!.focus({preventScroll: true});
    stopFrame(); settle(); current = next; elapsed = 0;
    cards = ['.art-window', '.art-mini', '.floating-tag', '.art-label'].map(selector => slides[current].querySelector<HTMLElement>(selector)!);
    slides.forEach((slide, i) => {
      slide.dataset.position = i === current ? 'active' : i === previous ? 'outgoing' : 'hidden';
      slide.setAttribute('aria-hidden', String(i !== current));
      slide.querySelector('a')!.tabIndex = i === current ? 0 : -1;
      dots[i].setAttribute('aria-pressed', String(i === current));
      fills[i].style.transform = 'scaleX(0)';
    });
    if (!reducedMotion) {
      slides[current].style.clipPath = `url(#liquid-clip-${current})`;
      root!.dataset.transitioning = 'true';
      renderReveal();
    } else settle();
    if (shouldAnnounce) announce();
    syncPlayback();
  }
  dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));
  root.querySelector('[data-shuffle]')?.addEventListener('click', () => show(current + 1 + Math.floor(Math.random() * (slides.length - 1))));
  root.addEventListener('keydown', e => {
    if (e.key === 'ArrowRight') { e.preventDefault(); show(current + 1); }
    if (e.key === 'ArrowLeft') { e.preventDefault(); show(current - 1); }
    if (e.code === 'Space' && e.target === root) e.preventDefault();
  });
  // Visibility and viewport changes pause the shared elapsed time. Language
  // changes only refresh the announcement, never the animation deadline.
  document.addEventListener('visibilitychange', syncPlayback);
  reduced.addEventListener('change', syncPlayback);
  new MutationObserver(() => { if (status.textContent) announce(); }).observe(document.documentElement, {attributes: true, attributeFilter: ['lang']});
  new IntersectionObserver(entries => { inView = entries[0].isIntersecting; syncPlayback(); }).observe(root);
  new ResizeObserver(() => {
    motionScale = root!.clientWidth <= 800 ? .45 : 1;
    if (current >= 0) { renderScene(); renderReveal(); }
  }).observe(root);
  let touch: {x: number; y: number; id: number} | null = null;
  root.addEventListener('touchstart', e => {
    const first = e.touches[0];
    touch = e.touches.length === 1 ? {x: first.clientX, y: first.clientY, id: first.identifier} : null;
  }, {passive: true});
  root.addEventListener('touchcancel', () => { touch = null; }, {passive: true});
  root.addEventListener('touchend', e => {
    if (!touch) return;
    const end = Array.from(e.changedTouches).find(item => item.identifier === touch!.id);
    const start = touch; touch = null;
    if (!end) return;
    const dx = end.clientX - start.x, dy = end.clientY - start.y;
    if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 1.5) show(current + (dx < 0 ? 1 : -1));
  }, {passive: true});
  show(Math.floor(Math.random() * slides.length), false);
}
</script>
<style>
.scenario{height:100svh;min-height:420px;position:relative;overflow:hidden;isolation:isolate;background:#caff56;color:#151615;touch-action:pan-y}
