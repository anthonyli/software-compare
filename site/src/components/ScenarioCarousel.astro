.scenario-stage{position:absolute;inset:0;overflow:hidden}.liquid-defs{position:absolute;width:0;height:0}.liquid-rim{position:absolute;inset:0;width:100%;height:100%;z-index:3;pointer-events:none;overflow:visible}.liquid-rim path{fill:none;stroke:#ffffff8a;stroke-width:.003;filter:drop-shadow(0 0 6px #ffffff60)}
