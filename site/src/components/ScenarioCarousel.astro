<section class="scenario" data-scenario tabindex="0" aria-describedby="scenario-help" aria-roledescription="carousel" aria-label="探索使用场景" data-i18n="aria-label" data-zh="探索使用场景" data-en="Explore use cases">
<div class="scenario-top"><span class="eyebrow"><span class="spark">✳</span> COMPARE / PLAYGROUND</span><a href="#categories"><T zh="所有分类" en="All categories"/> ↗</a></div>
<div class="scenario-heading"><h1><T zh="今天，你想做什么？" en="What will you make today?"/></h1><p><T zh="从一个想法出发，发现刚刚好的工具。" en="Start with an idea. Find the tools to make it happen."/></p></div>
<div class="scenario-stage">
<svg class="liquid-defs" aria-hidden="true"><defs>{scenes.map((_,i)=><clipPath id={`liquid-clip-${i}`} clipPathUnits="objectBoundingBox"><path data-liquid-path={i} d="M0,0H1V1H0Z"/></clipPath>)}</defs></svg>
<svg class="liquid-rim" viewBox="0 0 1 1" preserveAspectRatio="none" aria-hidden="true"><path data-liquid-rim d=""/></svg>
{scenes.map((s,i)=><article class="scene" data-scene data-position={i===0?'active':'hidden'} aria-hidden={i!==0?'true':'false'} style={`--scene-color:${s.color}`}><div class="scene-copy"><span class="scene-index">{s.tag}</span><h2><T zh={s.zh} en={s.en}/></h2><p><T zh={s.sub} en={s.subEn}/></p><a class="scene-link" href={`/c/${s.slug}/`} tabindex={i===0?0:-1}><T zh="发现适合的工具" en="Explore the tools"/><span>↗</span></a></div><div class={`scene-art art-${s.kind}`} aria-hidden="true"><div class="art-halo"></div><div class="art-orbit"></div><div class="floating-tag">{s.label}</div><div class="art-window"><div class="window-bar"><i></i><i></i><i></i><span>{s.file}</span></div><div class="window-content"><div class="art-symbol">{s.symbol}</div><div class="mock-lines"><b></b><b></b><b></b></div><div class="mock-grid"><i></i><i></i><i></i></div></div></div><div class="art-mini"><span>{s.kind==='record'?'00:24':s.kind==='data'?'∞':s.kind==='image'?'Aa':s.kind==='backend'?'API':'⌘'}</span><div class="mini-bars"><i></i><i></i><i></i><i></i><i></i></div></div><div class="art-label">{s.tools}</div></div></article>)}
</div>
<div class="scenario-controls"><button class="shuffle" data-shuffle><span>⤨</span><T zh="给我点灵感" en="Surprise me"/></button><div class="scene-dots">{scenes.map((s,i)=><button data-dot={i} aria-label={s.zh} data-i18n="aria-label" data-zh={s.zh} data-en={s.en} aria-pressed={i===0?'true':'false'}><span><i></i></span></button>)}</div></div><p id="scenario-help" class="scenario-help"><T zh="点击当前进度暂停 · 左右键切换" en="Tap the active progress to pause · Arrow keys to explore"/></p><p class="scenario-status sr-only" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
const root = document.querySelector<HTMLElement>('[data-scenario]');
if (root) {
  const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-scene]'));
  const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
  const paths = Array.from(root.querySelectorAll<SVGPathElement>('[data-liquid-path]'));
  const rim = root.querySelector<SVGPathElement>('[data-liquid-rim]')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  let current = -1, frame = 0, generation = 0;
  let timer: ReturnType<typeof setTimeout> | undefined;
  let progress: Animation | undefined;
  let userPaused = false, focused = false, inView = true;
  const delay = 6000, duration = 1250;
  const depthAnimations = new Map<HTMLElement, Animation[]>();

  // A smooth, continuously deforming liquid boundary. Coordinates are normalized,
  // so the same reveal covers wide, narrow and resized viewports without a canvas.
  function wavePath(radius: number, phase: number, strength: number, scene = current, rotation = 0) {
    // Deliberate families: soft triangle, five-petal flower, bean, four-leaf
    // clover, scalloped bloom, and almost-round pebble (not six noisy blobs).
    const lobes=[3,5,2,4,6,1][scene];
    const seed=[.35,.8,1.1,Math.PI,0,.4][scene];
    const amplitude=[.14,.18,.24,.30,.14,.035][scene]*(strength/.14);
    const drift=phase*[.25,.22,.20,.08,.16,.12][scene];
    const points = Array.from({length:72}, (_,i) => {
      const a = i / 72 * Math.PI * 2;
      const r = radius * (1 + amplitude * Math.cos(a*lobes + drift+seed) + amplitude*.12*Math.sin(a*(lobes+3)-drift+seed));
      return [.5 + Math.cos(a+rotation)*r, .48 + Math.sin(a+rotation)*r];
    });
    const mid = (a:number[], b:number[]) => `${((a[0]+b[0])/2).toFixed(5)},${((a[1]+b[1])/2).toFixed(5)}`;
    let d = `M${mid(points[71],points[0])}`;
    points.forEach((p,i) => { d += `Q${p[0].toFixed(5)},${p[1].toFixed(5)} ${mid(p,points[(i+1)%72])}`; });
    return d + 'Z';
  }
  function settle() {
    cancelAnimationFrame(frame);
    slides.forEach((slide,i) => {
      slide.style.clipPath = 'none'; slide.style.opacity = '';
      slide.dataset.position = i === current ? 'active' : 'hidden';
      if(i!==current){depthAnimations.get(slide)?.forEach(a=>a.cancel());depthAnimations.delete(slide);}
    });
    rim.setAttribute('d',''); root!.dataset.transitioning = 'false';
    root!.dataset.revealProgress = '1';
  }
  function schedule() {
    clearTimeout(timer); progress?.cancel();
    if (current < 0) return;
    if (reduced.matches) { settle(); root!.getAnimations({subtree:true}).forEach(a=>a.cancel()); }
    const paused = userPaused || focused || !inView || document.hidden || reduced.matches;
    root!.dataset.autoplay = paused ? 'paused' : 'running';
    root!.dataset.userPaused = String(userPaused);
    depthAnimations.forEach(animations=>animations.forEach(a=>paused?a.pause():a.play()));
    const en = document.documentElement.lang === 'en';
    dots.forEach((dot,i)=>{
      const name=dot.getAttribute(en?'data-en':'data-zh')!;
      dot.setAttribute('aria-label', i===current && !reduced.matches ? `${name} · ${userPaused?(en?'Resume autoplay':'继续自动轮播'):(en?'Pause autoplay':'暂停自动轮播')}` : name);
    });
    if (!paused) {
      progress=dots[current].querySelector('i')!.animate([{transform:'scaleX(0)'},{transform:'scaleX(1)'}],{duration:delay,fill:'forwards'});
      timer=setTimeout(()=>show(current+1,false),delay);
    }
  }
  function show(index:number, announce=true) {
    const next=(index+slides.length)%slides.length;
    if(next===current){schedule();return;}
    const previous=current, token=++generation;
    settle(); current=next;
    slides.forEach((slide,i)=>{
      slide.dataset.position=i===current?'active':i===previous?'outgoing':'hidden';
      slide.setAttribute('aria-hidden',String(i!==current));
      slide.querySelector('a')!.tabIndex=i===current?0:-1;
      dots[i].setAttribute('aria-pressed',String(i===current));
    });
    if(!reduced.matches){
      const entering=slides[current];
      // Independent camera drift: slow movement through depth, not a fast scale
      // tied to the wipe. Preserve each card's own tilt and responsive transform.
      const camera=Array.from(entering.querySelectorAll<HTMLElement>('.art-window,.art-mini,.floating-tag,.art-label')).map((card,i)=>{
        const tilt=getComputedStyle(card).transform;
        return card.animate([
          {transform:`translateZ(${-180-i*35}px) ${tilt==='none'?'':tilt}`},
          {transform:`translateZ(${100+i*18}px) ${tilt==='none'?'':tilt}`}
        ],{duration:delay+duration,easing:'linear',fill:'forwards'});
      });
      depthAnimations.set(entering,camera);
      entering.style.clipPath=`url(#liquid-clip-${current})`;
      paths[current].setAttribute('d',wavePath(.015,0,.18));
      root!.dataset.transitioning='true';
      root!.dataset.revealProgress='0';
      const start=performance.now();
      function tick(now:number){
        if(token!==generation)return;
        const t=Math.min(1,(now-start)/duration);
        // Expansion accelerates across the screen; the wave edge continually ripples.
        const smooth=(x:number)=>x*x*(3-2*x);
        // A quick catch, not a long held breath: reach (525ms), recoil
        // (163ms), then visibly turn the silhouette as it releases (562ms).
        const radius=t<.42 ? .015+.305*smooth(t/.42)
          : t<.55 ? .32-.035*smooth((t-.42)/.13)
          : .285+.815*smooth((t-.55)/.45);
        const turn=smooth(Math.max(0,Math.min(1,(t-.51)/.36)))*[.62,-.52,.7,-.65,.48,-.45][current];
        root!.dataset.revealRadius=radius.toFixed(4);
        root!.dataset.revealRotation=turn.toFixed(4);
        const d=wavePath(radius,t*1.2,.14-.08*Math.max(0,(t-.8)/.2),current,turn);
        paths[current].setAttribute('d',d);rim.setAttribute('d',d);
        entering.style.opacity=String(Math.min(1,.6+t*1.6));
        rim.style.opacity=String(Math.sin(Math.PI*t)*.65);
        root!.dataset.revealProgress=t.toFixed(3);
        if(t<1)frame=requestAnimationFrame(tick);else settle();
      }
      frame=requestAnimationFrame(tick);
    } else settle();
    if(announce)root!.querySelector('.scenario-status')!.textContent=`${current+1} / ${slides.length}: ${dots[current].getAttribute(document.documentElement.lang==='en'?'data-en':'data-zh')}`;
    schedule();
  }
  dots.forEach((dot,i)=>dot.addEventListener('click',()=>{
    if(i===current){userPaused=!userPaused;focused=false;schedule();}
    else show(i);
  }));
  root.querySelector('[data-shuffle]')?.addEventListener('click',()=>show(current+1+Math.floor(Math.random()*(slides.length-1))));
  root.addEventListener('keydown',e=>{
    if(e.key==='ArrowRight'){e.preventDefault();show(current+1);}
    if(e.key==='ArrowLeft'){e.preventDefault();show(current-1);}
    if(e.code==='Space' && e.target===root){e.preventDefault();userPaused=!userPaused;schedule();}
  });
  // Hover never interrupts playback. Keyboard focus and explicit pause still do.
  root.addEventListener('focusin',e=>{focused=e.target!==dots[current];schedule();});
  root.addEventListener('focusout',e=>{focused=!!e.relatedTarget&&root!.contains(e.relatedTarget as Node)&&e.relatedTarget!==dots[current];schedule();});
  document.addEventListener('visibilitychange',schedule);
  reduced.addEventListener('change',schedule);
  new MutationObserver(schedule).observe(document.documentElement,{attributes:true,attributeFilter:['lang']});
  new IntersectionObserver(entries=>{inView=entries[0].isIntersecting;schedule();}).observe(root);
  let x=0,y=0;
  root.addEventListener('touchstart',e=>{x=e.touches[0].clientX;y=e.touches[0].clientY;clearTimeout(timer);},{passive:true});
  root.addEventListener('touchend',e=>{const dx=e.changedTouches[0].clientX-x,dy=e.changedTouches[0].clientY-y;if(Math.abs(dx)>60&&Math.abs(dx)>Math.abs(dy)*1.5)show(current+(dx<0?1:-1));else schedule();},{passive:true});
  root.addEventListener('touchcancel',schedule,{passive:true});
  show(Math.floor(Math.random()*slides.length),false);
}
</script>
