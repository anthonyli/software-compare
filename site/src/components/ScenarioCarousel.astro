---
<section class="scenario" data-scenario aria-roledescription="carousel" aria-label="探索使用场景" data-i18n="aria-label" data-zh="探索使用场景" data-en="Explore use cases">
<div class="scenario-top"><span class="eyebrow"><span class="spark">✳</span> COMPARE / PLAYGROUND</span><a href="#categories"><T zh="所有分类" en="All categories"/> ↗</a></div>
<div class="scenario-heading"><h1><T zh="今天，你想做什么？" en="What will you make today?"/></h1><p><T zh="从一个想法出发，发现刚刚好的工具。" en="Start with an idea. Find the tools to make it happen."/></p></div>
<div class="scenario-stage"><div class="stage-orbit" aria-hidden="true"></div><div class="stage-orbit second" aria-hidden="true"></div>
{scenes.map((s,i)=><article class="scene" data-scene data-position={i===0?'active':i===1?'next':i===5?'previous':'hidden'} aria-hidden={i!==0?'true':'false'} style={`--scene-color:${s.color}`}><div class="scene-copy"><span class="scene-index">{s.tag}</span><h2><T zh={s.zh} en={s.en}/></h2><p><T zh={s.sub} en={s.subEn}/></p><a class="scene-link" href={`/c/${s.slug}/`} tabindex={i===0?0:-1}><T zh="发现适合的工具" en="Explore the tools"/><span>↗</span></a></div><div class={`scene-art art-${s.kind}`} aria-hidden="true"><div class="art-halo"></div><div class="art-orbit"></div><div class="floating-tag">{s.label}</div><div class="art-window"><div class="window-bar"><i></i><i></i><i></i><span>{s.file}</span></div><div class="window-content"><div class="art-symbol">{s.symbol}</div><div class="mock-lines"><b></b><b></b><b></b></div><div class="mock-grid"><i></i><i></i><i></i></div></div></div><div class="art-mini"><span>{s.kind==='record'?'00:24':s.kind==='data'?'∞':s.kind==='image'?'Aa':s.kind==='backend'?'API':'⌘'}</span><div class="mini-bars"><i></i><i></i><i></i><i></i><i></i></div></div><div class="art-label">{s.tools}</div></div></article>)}
</div>
<div class="scenario-controls"><button class="shuffle" data-shuffle><span>⤨</span><T zh="给我点灵感" en="Surprise me"/></button><div class="scene-dots">{scenes.map((s,i)=><button data-dot={i} aria-label={s.zh} data-i18n="aria-label" data-zh={s.zh} data-en={s.en} aria-pressed={i===0?'true':'false'}><span><i></i></span></button>)}</div><div class="scene-arrows"><button class="playback" data-playback aria-label="暂停自动轮播" aria-pressed="false"><span data-pause-copy><T zh="暂停" en="Pause" /></span><span data-play-copy hidden><T zh="播放" en="Play" /></span><span data-reduced-copy hidden><T zh="静态" en="Still" /></span></button><button data-prev aria-label="上一个场景" data-i18n="aria-label" data-zh="上一个场景" data-en="Previous scene">←</button><button data-next aria-label="下一个场景" data-i18n="aria-label" data-zh="下一个场景" data-en="Next scene">→</button></div></div><p class="scenario-status sr-only" aria-live="polite" aria-atomic="true"></p>
</section>
<script>
const root = document.querySelector<HTMLElement>('[data-scenario]');
if (root) {
  const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-scene]'));
  const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
  const playback = root.querySelector<HTMLButtonElement>('[data-playback]')!;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const delay = 4500;
  let current = 0;
  let timer: ReturnType<typeof setTimeout> | undefined;
  let userPaused = false;
  let hovered = false;
  let focused = false;
  let inView = true;
  let progress: Animation | undefined;

  function schedule() {
    clearTimeout(timer);
    progress?.cancel();
    if (reducedMotion.matches) root!.getAnimations({subtree:true}).forEach(animation => animation.cancel());
    const paused = userPaused || hovered || focused || !inView || document.hidden || reducedMotion.matches;
    root!.dataset.autoplay = paused ? 'paused' : 'running';
    playback.disabled = reducedMotion.matches;
    playback.setAttribute('aria-pressed', String(userPaused || reducedMotion.matches));
    const en = document.documentElement.lang === 'en';
    playback.setAttribute('aria-label', reducedMotion.matches
      ? (en ? 'Automatic motion disabled by your preference' : '已遵循系统减少动态效果设置')
      : userPaused ? (en ? 'Play slideshow' : '播放自动轮播') : (en ? 'Pause slideshow' : '暂停自动轮播'));
    playback.querySelector<HTMLElement>('[data-pause-copy]')!.hidden = userPaused || reducedMotion.matches;
    playback.querySelector<HTMLElement>('[data-play-copy]')!.hidden = !userPaused || reducedMotion.matches;
    playback.querySelector<HTMLElement>('[data-reduced-copy]')!.hidden = !reducedMotion.matches;
    if (!paused) {
      progress = dots[current].querySelector('i')!.animate([{transform:'scaleX(0)'},{transform:'scaleX(1)'}], {duration:delay,fill:'forwards'});
      timer = setTimeout(() => show(current + 1, false), delay);
    }
  }
  function show(index: number, announce = true) {
    const previous = current;
    current = (index + slides.length) % slides.length;
    const color = slides[current].style.getPropertyValue('--scene-color');
    document.body.style.setProperty('--playground-accent', color);
    root!.style.setProperty('--glow-shift', `${(current - 2) * 8}%`);
    slides.forEach((slide, i) => {
      const delta = (i - current + slides.length) % slides.length;
      slide.dataset.position = delta === 0 ? 'active' : delta === 1 ? 'next' : delta === slides.length - 1 ? 'previous' : 'hidden';
      slide.setAttribute('aria-hidden', String(delta !== 0));
      slide.querySelector('a')!.tabIndex = delta === 0 ? 0 : -1;
      dots[i].setAttribute('aria-pressed', String(delta === 0));
    });
    if (!reducedMotion.matches && previous !== current) {
      const entering = slides[current];
      const forward = (current - previous + slides.length) % slides.length <= slides.length / 2;
      const direction = forward ? 1 : -1;
      // The panel bends into place while copy and artwork arrive at different depths.
      entering.getAnimations().filter(animation => animation instanceof CSSAnimation === false && !(animation instanceof CSSTransition)).forEach(animation => animation.cancel());
      entering.animate([
        {borderRadius:'42% 9% 38% 12% / 28% 42% 23% 45%'},
        {borderRadius:'9% 17% 8% 14% / 16% 12% 15% 10%',offset:.6},
        {borderRadius:'26px'}
      ],{duration:1150,easing:'cubic-bezier(.16,.8,.2,1)'});
      const art = entering.querySelector<HTMLElement>('.scene-art')!;
      const copy = entering.querySelector<HTMLElement>('.scene-copy')!;
      art.getAnimations().forEach(animation => animation.cancel());
      copy.getAnimations().forEach(animation => animation.cancel());
      art.animate([{transform:`translate3d(${direction*90}px,28px,-120px) rotateY(${direction*-18}deg) scale(.85)`,opacity:.25},{transform:'translate3d(0,0,0) rotateY(0) scale(1)',opacity:1}],{duration:1250,easing:'cubic-bezier(.16,.8,.2,1)'});
      copy.animate([{transform:`translateX(${direction*35}px)`,opacity:0},{transform:'translateX(0)',opacity:1}],{duration:800,delay:150,fill:'backwards',easing:'cubic-bezier(.16,.8,.2,1)'});
    }
    if (announce) root!.querySelector('.scenario-status')!.textContent = `${current + 1} / ${slides.length}: ${dots[current].getAttribute('aria-label')}`;
    schedule();
  }
  root.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
  root.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));
  root.querySelector('[data-shuffle]')?.addEventListener('click', () => show(current + 1 + Math.floor(Math.random() * (slides.length - 1))));
  dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));
  root.addEventListener('keydown', event => {
    if (event.key === 'ArrowRight') { event.preventDefault(); show(current + 1); }
    if (event.key === 'ArrowLeft') { event.preventDefault(); show(current - 1); }
  });
  playback.addEventListener('click', () => { userPaused = !userPaused; schedule(); });
  root.addEventListener('pointerenter', event => { if (event.pointerType === 'mouse') { hovered = true; schedule(); } });
  root.addEventListener('pointerleave', event => { if (event.pointerType === 'mouse') { hovered = false; schedule(); } });
  // Keep focused content still. The explicit play/pause control can resume without losing focus.
  root.addEventListener('focusin', event => { focused = event.target !== playback; schedule(); });
  root.addEventListener('focusout', event => { focused = !!event.relatedTarget && root!.contains(event.relatedTarget as Node) && event.relatedTarget !== playback; schedule(); });
  document.addEventListener('visibilitychange', schedule);
  reducedMotion.addEventListener('change', schedule);
  new MutationObserver(schedule).observe(document.documentElement, { attributes: true, attributeFilter: ['lang'] });
  new IntersectionObserver(entries => { inView = entries[0].isIntersecting; schedule(); }, { threshold: 0 }).observe(root);
  let x = 0, y = 0;
  const stage = root.querySelector<HTMLElement>('.scenario-stage')!;
  stage.addEventListener('touchstart', event => { x = event.touches[0].clientX; y = event.touches[0].clientY; clearTimeout(timer); }, { passive: true });
  stage.addEventListener('touchend', event => {
    const dx = event.changedTouches[0].clientX - x, dy = event.changedTouches[0].clientY - y;
    if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 1.5) show(current + (dx < 0 ? 1 : -1));
    else schedule();
  }, { passive: true });
  stage.addEventListener('touchcancel', schedule, { passive: true });
  show(Math.floor(Math.random() * slides.length), false);
}
</script>
<style>
