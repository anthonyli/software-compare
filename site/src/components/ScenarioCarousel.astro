opacity:.45;filter:brightness(.65);pointer-events:none}.scene[data-position=hidden]{transform:translateZ(-700px) scale(.7);opacity:0;z-index:0;pointer-events:none}.scene-copy{padding:32px 0 28px 36px;display:flex;align-items:flex-start;flex-direction:column;position:relative;z-index:2}.scene-index{font-size:11px;font-weight:600;letter-spacing:.13em;border:1px solid #15161555;border-radius:100px;padding:7px 11px}.scene-copy h2{font-size:clamp(28px,2.8vw,40px);line-height:1.15;font-weight:700;letter-spacing:-.045em;margin-top:28px}.scene-copy p{margin-top:16px;font-size:14px;line-height:1.8;max-width:330px}.scene-link{background:#151615;color:#fff!important;border-radius:100px;padding:13px 19px;font-size:13px;margin-top:auto;display:flex;gap:25px;align-items:center}.scene-link span:last-child{font-size:21px;line-height:1}.scene-link:hover{background:#30352b;transform:translateY(-2px)}.scene-link:focus-visible,.scenario button:focus-visible,.scenario-top a:focus-visible{outline:3px solid #fff;outline-offset:5px}.scene-art{position:relative;perspective:800px;min-width:0}.art-halo{position:absolute;width:310px;height:310px;background:radial-gradient(circle at 35% 25%,#ffffffa8,transparent 64%);border:1px solid #ffffff60;box-shadow:inset -20px -25px 40px #0001;border-radius:50%;top:32px;left:30px}.art-orbit{position:absolute;border:1px solid #15161535;width:380px;height:170px;border-radius:50%;top:110px;left:0;transform:rotate(-35deg)}.art-window{position:absolute;top:80px;left:14px;width:310px;height:230px;background:#fafbf6;box-shadow:12px 22px 0 #15161516,25px 35px 35px #15161525;border-radius:15px;transform:rotateY(-18deg) rotateX(10deg) rotateZ(-8deg);border:1px solid #fff;transition:transform 1s cubic-bezier(.2,.75,.15,1)}.scene[data-position=active]:hover .art-window{transform:rotateY(-7deg) rotateX(5deg) rotateZ(-4deg) translateY(-5px)}.window-bar{border-bottom:1px solid #15161515;height:29px;display:flex;align-items:center;gap:4px;padding:0 11px}.window-bar i{wid