.art-window{position:absolute;left:-5%;top:27%;width:340px;height:255px;background:linear-gradient(130deg,#ffffff16,#ffffff06);border:1px solid #ffffff25;box-shadow:0 30px 60px #0005,inset 0 1px #fff2;border-radius:18px;transform:rotateY(18deg) rotateZ(-14deg);opacity:.72;backdrop-filter:blur(12px)}.window-bar{height:32px;border-bottom:1px solid #fff2;display:flex;align-items:center;gap:5px;padding:0 13px}.window-bar i{height:5px;width:5px;border-radius:50%;background:#fff5}.window-bar span{font-size:9px;color:#fff8;margin-left:9px}.window-content{position:relative;padding:22px}
.art-mini{position:absolute;right:-2%;bottom:20%;width:270px;height:290px;padding:35px;border-radius:28px;border:1px solid #fff2;background:linear-gradient(135deg,#ffffff12,#ffffff03);box-shadow:0 30px 80px #0006;transform:rotateY(-20deg) rotateZ(12deg);opacity:.72;backdrop-filter:blur(14px)}.floating-tag{position:absolute;right:17%;top:15%;padding:15px 23px;border:1px solid #fff2;border-radius:14px;font-size:13px;background:#ffffff0c;box-shadow:0 15px 35px #0002;transform:rotate(12deg);color:#ffffff80}.art-label{position:absolute;left:17%;bottom:17%;font-size:12px;letter-spacing:.06em;border:1px solid #fff2;background:#ffffff08;padding:17px 24px;border-radius:14px;transform:rotate(-7deg);color:#ffffff80}
