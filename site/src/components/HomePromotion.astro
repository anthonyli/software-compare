---
// SPDX-License-Identifier: Apache-2.0
import T from './T.astro';
interface Props { enabled?: boolean }
const { enabled = true } = Astro.props;
---
{enabled && (
  <aside id="home-promotion" class="home-promotion" hidden>
    <a href="https://pageon.cc" rel="sponsored noopener" class="promotion-link">
      <span class="dir-cover promotion-art" aria-hidden="true">
        <svg viewBox="0 0 160 100" fill="none">
          <rect x="21" y="20" width="112" height="65" rx="8" fill="#D9E4DA" />
          <rect x="30" y="12" width="112" height="65" rx="8" fill="#FFFDF7" stroke="#314C43" stroke-width="2" />
          <path d="M43 29H83M43 39H72M43 55H62" stroke="#314C43" stroke-width="4" stroke-linecap="round" />
          <rect x="94" y="26" width="33" height="33" rx="7" fill="#E8C9A6" />
          <circle cx="122" cy="70" r="17" fill="#AFCAB8" stroke="#314C43" stroke-width="2" />
          <path d="M115 70H129M123 64L129 70L123 76" stroke="#314C43" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <span class="dir-body promotion-copy">
        <span class="dir-name">Pageon <span class="promotion-label"><T zh="推广" en="Promotion" /></span></span>
        <span class="dir-meta"><T zh="了解 Pageon，让想法更好地呈现 ↗" en="Explore Pageon. Bring ideas to life ↗" /></span>
      </span>
    </a>
  </aside>
)}
<!-- Select a group on each full page load; never register the promotion as a category.
     Homepage search is a suggestion overlay, not a group-hiding filter. -->
<script is:inline>
  (() => {
    const promotion = document.getElementById('home-promotion');
    const grids = document.querySelectorAll('#categories > [data-category-group] > .dir-grid');
    if (!promotion) return;
    if (!grids.length) { promotion.remove(); return; }
    const index = Math.floor(Math.random() * grids.length);
    grids[index].append(promotion);
    promotion.hidden = false;
  })();
</script>
<style>
  .home-promotion[hidden] { display: none; }
  .home-promotion { min-width: 0; }
  .promotion-link { display: flex; flex-direction: column; height: 100%; min-width: 0; border-radius: var(--radius-card); box-shadow: var(--shadow-card); overflow: hidden; background: white; color: #243d33; text-decoration: none; transition: transform 160ms var(--ease-out), box-shadow 160ms var(--ease-out); }
  .promotion-link:hover { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(17, 17, 17, .08); }
  .promotion-link:focus-visible { outline: 3px solid #527f65; outline-offset: 4px; }
  .promotion-art { background: #eef3eb; }
  .promotion-art svg { display: block; width: 100%; height: 100%; }
  .promotion-copy { flex: 1; }
  .promotion-label { display: inline-block; vertical-align: middle; margin-left: .4rem; font-size: .6rem; font-weight: 600; padding: .1rem .3rem; border: 1px solid #8ea693; border-radius: .3rem; color: #395547; }
</style>
