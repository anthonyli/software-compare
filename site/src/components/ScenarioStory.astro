---
interface Props { kind: string; compact?: boolean }
const { kind, compact = false } = Astro.props;
---
<svg class:list={['story', `story-${kind}`, {compact}]} viewBox="0 0 260 180" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  {!compact && kind === 'web' && <>
    <path class="soft" d="M30 147h200M50 157h160"/>
    <g class="launch-house">
      <path class="paper" d="M75 85 130 43l55 42v62H75Z"/>
      <path class="ink" d="m65 89 65-51 65 51"/>
      <rect class="tint" x="112" y="104" width="36" height="43" rx="18"/>
      <rect class="ink" x="91" y="89" width="14" height="14" rx="4"/>
      <rect class="ink" x="155" y="89" width="14" height="14" rx="4"/>
      <path class="ink" d="M122 120q8 8 16 0"/>
      <circle class="solid" cx="124" cy="113" r="2"/><circle class="solid" cx="136" cy="113" r="2"/>
    </g>
    <g class="launch-flag"><path class="ink" d="M166 59V21"/><path class="tint" d="M167 22h32l-9 11 9 11h-32Z"/><path class="ink" d="m174 32 4 4 8-8"/></g>
    <g class="launch-spark"><path class="ink" d="M41 57v16m-8-8h16M213 91v12m-6-6h12"/><circle class="tint" cx="57" cy="111" r="5"/></g>
    <g class="tiny-cloud"><path class="paper" d="M195 61a9 9 0 0 1 15-7 12 12 0 0 1 22 7c11 1 11 15 0 15h-34c-10 0-12-13-3-15Z"/></g>
  </>}
  {!compact && kind === 'record' && <>
    <rect class="soft-fill" x="34" y="30" width="192" height="122" rx="22"/>
    <path class="ink" d="M40 60V40h20m140 0h20v20M40 120v20h20m140 0h20v-20"/>
    <g class="record-friend">
      <path class="tint" d="M91 69c-16-35 1-43 18-19 12-4 30-4 42 0 17-24 34-16 18 19 7 8 11 19 11 33 0 30-100 30-100 0 0-14 4-25 11-33Z"/>
      <ellipse class="solid" cx="113" cy="91" rx="3" ry="4"/><ellipse class="solid" cx="147" cy="91" rx="3" ry="4"/>
      <path class="ink" d="M122 104q8 9 16 0"/><path class="soft" d="M96 102h8m52 0h8"/>
    </g>
    <g class="record-wave"><path class="tint" d="M174 109c16-24 28-16 19-3l-12 19"/></g>
    <g class="record-heart"><path fill="#ed7d94" d="M196 68c-24-14-11-29 0-18 11-11 24 4 0 18Z"/></g>
    <circle class="rec-light" cx="52" cy="52" r="4" fill="#ed7d94"/>
    <path class="soft" d="M91 142h78"/><path class="record-scrub ink" d="M91 142h78" pathLength="1"/>
    <path class="record-glint ink" d="M61 95h12m-6-6v12"/>
  </>}
  {!compact && kind === 'mail' && <>
    <path class="mail-route soft" d="M24 122c44 38 30-84 88-73s-27 68-46 28 64-53 125-19" stroke-dasharray="4 7"/>
    <g class="mail-letter">
      <rect class="paper" x="91" y="65" width="104" height="73" rx="12"/>
      <path class="tint" d="m92 70 51 37 51-37v56c0 7-5 12-12 12h-78c-7 0-12-5-12-12Z"/>
      <path class="ink" d="m95 135 33-28m63 28-33-28"/>
      <path fill="#ed7d94" d="M143 113c-25-15-12-31 0-19 12-12 25 4 0 19Z"/>
    </g>
    <g class="mail-arrival"><circle class="paper" cx="200" cy="63" r="19"/><path class="ink" d="m191 63 6 6 12-13"/></g>
    <g class="mail-wing"><path class="ink" d="m67 122-18 5m21 5-13 10"/></g>
    <path class="soft" d="M103 157h80"/>
  </>}
  {!compact && kind === 'data' && <>
    <path class="soft" d="M42 153h179"/>
    <path class="ink" d="m59 65 71-44 71 44"/>
    <g class="data-home"><path class="paper" d="M72 84v45c0 25 116 25 116 0V84"/><ellipse class="tint" cx="130" cy="84" rx="58" ry="17"/><path class="ink" d="M72 106c0 23 116 23 116 0"/><circle class="solid" cx="116" cy="124" r="2.5"/><circle class="solid" cx="144" cy="124" r="2.5"/><path class="ink" d="M124 133q6 5 12 0"/></g>
    <g class="data-row row-one"><rect class="tint" x="91" y="53" width="28" height="19" rx="6"/><path class="ink" d="M101 63h8"/></g>
    <g class="data-row row-two"><rect class="tint" x="141" y="47" width="28" height="19" rx="6"/><path class="ink" d="M151 57h8"/></g>
    <g class="data-sprout"><path class="ink" d="M213 145v-27"/><path class="tint" d="M213 134c-19 1-23-12-23-12 17-5 24 5 23 12Zm0-9c0-18 15-22 15-22 7 14-3 23-15 22Z"/></g>
    <path class="data-star ink" d="M42 93v14m-7-7h14"/>
  </>}
  {!compact && kind === 'image' && <>
    <rect class="paper" x="57" y="23" width="145" height="134" rx="7" transform="rotate(-4 130 90)"/>
    <path class="paint-stroke" d="M80 116c8-63 22-71 32-22s23 42 30-6 24-43 35 16" stroke="var(--scene-color)" stroke-width="19" stroke-linecap="round" pathLength="1"/>
    <g class="paint-flower"><path class="tint" d="M146 67c-23-23-44 3-23 19-28 15-10 44 12 29 3 29 36 28 33 0 26 14 42-14 17-28 20-20-2-43-21-23-3-20-23-20-18 3Z"/><circle class="paper" cx="151" cy="90" r="18"/><circle class="solid" cx="145" cy="88" r="2"/><circle class="solid" cx="157" cy="88" r="2"/><path class="ink" d="M146 96q5 5 10 0"/></g>
    <g class="paint-pencil"><path class="paper" d="m61 127 76-81 12 12-76 81-19 6Z"/><path class="tint" d="m67 121 70-75 12 12-70 75Z"/><path class="ink" d="m61 127 12 12m-19 6 4-11"/></g>
    <g class="paint-dots"><circle fill="#ed7d94" cx="217" cy="52" r="5"/><circle class="tint" cx="38" cy="101" r="7"/><path class="ink" d="M220 110v14m-7-7h14"/></g>
  </>}
  {!compact && kind === 'backend' && <>
    <path class="backend-wires soft" d="M69 68h55v51h68M124 68h68M69 119h55" pathLength="1"/>
    <g class="backend-auth"><rect class="paper" x="34" y="39" width="64" height="57" rx="15"/><path class="ink" d="M56 65v-7a10 10 0 0 1 20 0v7"/><rect class="tint" x="50" y="64" width="32" height="22" rx="6"/><path class="ink" d="M66 73v5"/></g>
    <g class="backend-store"><rect class="tint" x="159" y="39" width="64" height="57" rx="15"/><path class="ink" d="M175 78V60h13l5 6h15v18h-33Z"/></g>
    <g class="backend-home"><rect class="paper" x="94" y="104" width="65" height="52" rx="17"/><circle class="solid" cx="116" cy="125" r="2.5"/><circle class="solid" cx="138" cy="125" r="2.5"/><path class="ink" d="M119 136q8 8 16 0"/></g>
    <g class="backend-packet"><circle class="tint" cx="124" cy="68" r="6"/></g>
    <g class="backend-ready"><path class="ink" d="m184 131 7 7 16-17M47 125v14m-7-7h14"/></g>
  </>}
  {compact && kind === 'web' && <>
    <path class="soft" d="M43 126c53 48 135 14 170-58" stroke-dasharray="4 7"/>
    <g class="launch-house"><path class="tint" d="m130 32 18 38 42 6-30 30 7 42-37-20-37 20 7-42-30-30 42-6Z"/><circle class="solid" cx="119" cy="89" r="3"/><circle class="solid" cx="141" cy="89" r="3"/><path class="ink" d="M120 103q10 10 20 0"/></g>
    <g class="launch-spark"><path class="ink" d="M51 58v16m-8-8h16M209 123v12m-6-6h12"/></g>
  </>}
  {compact && kind === 'record' && <>
    <rect class="ink" x="46" y="33" width="168" height="115" rx="16"/>
    <path class="soft" d="M46 58h168M46 124h168"/>
    <g class="record-heart"><path class="tint" d="M130 115c-63-38-29-78 0-48 29-30 63 10 0 48Z"/></g>
    <circle class="rec-light" cx="62" cy="45" r="4" fill="#ed7d94"/>
    <path class="record-scrub ink" d="M66 136h127" pathLength="1"/>
  </>}
  {compact && kind === 'mail' && <>
    <path class="soft" d="M64 153h140"/>
    <g class="mail-letter"><path class="tint" d="M74 124V76a31 31 0 0 1 31-31h45a34 34 0 0 1 34 34v45Z"/><path class="ink" d="M105 45a31 31 0 0 1 31 31v48M92 82h25M126 125v26"/></g>
    <g class="mail-arrival"><path class="ink" d="M182 87V37"/><path fill="#ed7d94" d="M182 36h27v20h-27Z"/></g>
    <path class="ink" d="M96 102q8 7 16 0"/>
  </>}
  {compact && kind === 'data' && <>
    <path class="paper" d="m95 110 9 39h52l9-39Z"/><path class="ink" d="M90 110h80"/>
    <g class="data-sprout"><path class="ink" d="M130 109V61"/><path class="tint" d="M130 85c-35 0-42-27-42-27 31-7 45 11 42 27Zm0-14c0-31 27-41 27-41 15 24-2 43-27 41Z"/></g>
    <circle class="solid" cx="119" cy="125" r="2.5"/><circle class="solid" cx="141" cy="125" r="2.5"/><path class="ink" d="M125 136q5 4 10 0"/>
    <g class="launch-spark"><path class="ink" d="M60 93v14m-7-7h14M192 58v14m-7-7h14"/></g>
  </>}
  {compact && kind === 'image' && <>
    <g class="paint-flower"><path class="tint" d="M121 55c-23-23-44 3-23 19-28 15-10 44 12 29 3 29 36 28 33 0 26 14 42-14 17-28 20-20-2-43-21-23-3-20-23-20-18 3Z"/><circle class="paper" cx="126" cy="78" r="18"/><circle class="solid" cx="120" cy="76" r="2"/><circle class="solid" cx="132" cy="76" r="2"/><path class="ink" d="M121 84q5 5 10 0"/></g>
    <path class="ink" d="M126 120v29m0-5 18-12"/>
    <g class="paint-dots"><circle class="tint" cx="65" cy="108" r="5"/><circle fill="#ed7d94" cx="189" cy="55" r="5"/><path class="ink" d="M196 114v12m-6-6h12"/></g>
  </>}
  {compact && kind === 'backend' && <>
    <g class="backend-auth"><rect class="tint" x="58" y="62" width="67" height="67" rx="19"/><path class="ink" d="m77 92 8 8 17-18"/></g>
    <g class="backend-store"><rect class="paper" x="136" y="62" width="67" height="67" rx="19"/><circle class="solid" cx="160" cy="88" r="3"/><circle class="solid" cx="179" cy="88" r="3"/><path class="ink" d="M162 102q8 7 16 0"/></g>
    <g class="backend-ready"><path class="ink" d="M130 27v14m-8-7h16M117 149h26"/></g>
  </>}
</svg>
<style>
.story{display:block;width:100%;height:100%;overflow:visible;color:#30352b;--paper:#fffef8}
.ink,.soft,.paper,.tint{stroke:currentColor;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}
.paper{fill:var(--paper)}.tint{fill:var(--scene-color)}.solid{fill:currentColor}.soft{opacity:.22}.soft-fill{fill:var(--scene-color);opacity:.22}
.compact{--paper:#30352b;color:#f7f6ea}.compact .tint{fill:var(--scene-color);stroke:#f7f6ea}.compact .solid{fill:var(--scene-color)}.compact .soft{opacity:.35}
/* Every pose is sampled by the carousel's one visible-time clock. No background loops. */
.story g,.story .rec-light,.story .record-scrub,.story .record-glint,.story .paint-stroke,.story .data-star{animation-duration:6s;animation-timing-function:linear;animation-fill-mode:both;animation-play-state:paused;animation-delay:var(--story-time,-4320ms);transform-box:fill-box;transform-origin:center}
.launch-house{animation-name:house-rise}.launch-flag{animation-name:flag-unfurl;transform-origin:0 100%!important}.launch-spark{animation-name:spark-grow}.tiny-cloud{animation-name:cloud-pass}
.record-friend{animation-name:friend-peek}.record-wave{animation-name:friend-wave;transform-origin:0 100%!important}.record-heart{animation-name:heart-hello}.rec-light{animation-name:record-light}.record-scrub{animation-name:record-line}.record-glint{animation-name:spark-grow}
.mail-letter{animation-name:letter-delivery}.mail-arrival{animation-name:delivery-check}.mail-wing{animation-name:mail-wings}
.data-home{animation-name:data-settle}.row-one{animation-name:row-one}.row-two{animation-name:row-two}.data-sprout{animation-name:sprout-grow;transform-origin:50% 100%!important}.data-star{animation-name:spark-grow}
.paint-stroke{animation-name:paint-line}.paint-pencil{animation-name:pencil-draw}.paint-flower{animation-name:flower-bloom}.paint-dots{animation-name:spark-grow}
.backend-auth{animation-name:auth-connect}.backend-store{animation-name:store-connect}.backend-home{animation-name:home-connect}.backend-packet{animation-name:packet-delivery}.backend-ready{animation-name:delivery-check}
@keyframes house-rise{0%{transform:translateY(15px) scale(.94)}45%{transform:translateY(-3px) scale(1)}65%,100%{transform:translateY(0)}}
@keyframes flag-unfurl{0%,18%{transform:scaleX(.1) rotate(-12deg)}48%{transform:scaleX(1) rotate(5deg)}72%,100%{transform:scaleX(1) rotate(0)}}
@keyframes spark-grow{0%,24%{transform:scale(.2);opacity:0}55%{transform:scale(1.15);opacity:1}72%,100%{transform:scale(1);opacity:1}}
@keyframes cloud-pass{from{transform:translateX(-10px)}to{transform:translateX(8px)}}
@keyframes friend-peek{0%{transform:translateY(24px) rotate(-8deg)}35%{transform:translateY(0) rotate(3deg)}65%,100%{transform:translateY(0) rotate(0)}}
@keyframes friend-wave{0%,24%{transform:rotate(15deg)}38%{transform:rotate(-20deg)}48%{transform:rotate(12deg)}58%{transform:rotate(-16deg)}72%,100%{transform:rotate(0)}}
@keyframes heart-hello{0%,30%{transform:translateY(12px) scale(.3);opacity:0}60%{transform:translateY(-4px) scale(1.2);opacity:1}72%,100%{transform:translateY(0) scale(1);opacity:1}}
@keyframes record-light{0%,25%,50%,75%,100%{opacity:1}12%,37%,62%,87%{opacity:.35}}
@keyframes record-line{from{stroke-dasharray:1;stroke-dashoffset:1}to{stroke-dasharray:1;stroke-dashoffset:0}}
@keyframes letter-delivery{0%{transform:translate(-48px,18px) rotate(-16deg)}32%{transform:translate(-13px,-15px) rotate(6deg)}66%,100%{transform:translate(0,0) rotate(0)}}
@keyframes delivery-check{0%,45%{transform:scale(.4);opacity:0}65%{transform:scale(1.15);opacity:1}75%,100%{transform:scale(1);opacity:1}}
@keyframes mail-wings{0%{transform:translateX(-15px);opacity:0}25%,60%{opacity:1}100%{transform:translateX(5px);opacity:.3}}
@keyframes data-settle{0%{transform:translateY(5px)}35%{transform:translateY(0)}45%{transform:translateY(3px)}65%,100%{transform:translateY(0)}}
@keyframes row-one{0%{transform:translate(-9px,-23px) rotate(-12deg);opacity:.3}36%,100%{transform:translate(0,0) rotate(0);opacity:1}}
@keyframes row-two{0%,15%{transform:translate(9px,-26px) rotate(12deg);opacity:.3}52%,100%{transform:translate(0,0) rotate(0);opacity:1}}
@keyframes sprout-grow{0%,25%{transform:scale(.35)}65%{transform:scale(1.08)}80%,100%{transform:scale(1)}}
@keyframes paint-line{0%,8%{stroke-dasharray:1;stroke-dashoffset:1}65%,100%{stroke-dasharray:1;stroke-dashoffset:0}}
@keyframes pencil-draw{0%{transform:translate(-15px,12px) rotate(-12deg)}32%{transform:translate(36px,-24px) rotate(12deg)}65%,100%{transform:translate(65px,26px) rotate(23deg)}}
@keyframes flower-bloom{0%,32%{transform:scale(.1) rotate(-40deg);opacity:0}65%{transform:scale(1.08) rotate(5deg);opacity:1}80%,100%{transform:scale(1) rotate(0);opacity:1}}
@keyframes auth-connect{0%{transform:translateX(-19px) rotate(-8deg)}55%,100%{transform:translateX(0) rotate(0)}}
@keyframes store-connect{0%{transform:translateX(19px) rotate(8deg)}55%,100%{transform:translateX(0) rotate(0)}}
@keyframes home-connect{0%,18%{transform:translateY(14px)}65%,100%{transform:translateY(0)}}
@keyframes packet-delivery{0%{transform:translateX(-55px);opacity:0}25%{transform:translateX(-28px);opacity:1}50%{transform:translate(0,0)}72%,100%{transform:translate(0,51px);opacity:1}}
</style>
