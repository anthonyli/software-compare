---
// SPDX-License-Identifier: Apache-2.0
import { ui, tr } from "../i18n";
import T from "./T.astro";
interface Props {
  official?: string | null;
  github?: string | null;
  sourceUrl?: string | null;
  sourceLabel?: string | null;
  size?: "sm" | "md";
  stacked?: boolean;
  iconOnly?: boolean;
  primaryOfficial?: boolean;
}
const {
  official,
  github,
  sourceUrl,
  sourceLabel,
  size = "sm",
  stacked = false,
  iconOnly = false,
  primaryOfficial = false,
} = Astro.props;

const icon = "icon-link";
const sourceText = sourceLabel || ui.zh.source;
const sourceTextEn = sourceLabel ? tr(sourceLabel) : ui.en.source;
const wrap = stacked
  ? "inline-flex flex-col items-stretch gap-1"
  : "inline-flex flex-wrap items-center gap-1.5";
---

<span class={wrap}>
  {official && (
    iconOnly ? (
      <a href={official} target="_blank" rel="noopener noreferrer" class={icon} aria-label={ui.zh.official} title={ui.zh.official} data-i18n="aria-label" data-zh={ui.zh.official} data-en={ui.en.official} onclick="event.stopPropagation()">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M6 3.5H3.5A1.5 1.5 0 0 0 2 5v7.5A1.5 1.5 0 0 0 3.5 14H11a1.5 1.5 0 0 0 1.5-1.5V10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
          <path d="M8 8l6-6M10 2h4v4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    ) : (
      <a href={official} target="_blank" rel="noopener noreferrer" class={primaryOfficial ? "btn btn-primary" : (size === "md" ? "btn btn-secondary" : "btn btn-secondary btn-sm")}>
        <T zh={ui.zh.official} en={ui.en.official} />
        <span aria-hidden="true">↗</span>
      </a>
    )
  )}
  {github && (
    iconOnly ? (
      <a href={github} target="_blank" rel="noopener noreferrer" class={icon} aria-label="GitHub" title="GitHub" onclick="event.stopPropagation()">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.68 7.68 0 0 1 8 4.14c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
      </a>
    ) : (
      <a href={github} target="_blank" rel="noopener noreferrer" class={size === "md" || primaryOfficial ? "btn btn-secondary" : "btn btn-secondary btn-sm"} title="GitHub">
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.68 7.68 0 0 1 8 4.14c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
        GitHub
      </a>
    )
  )}
  {!github && sourceUrl && (
    iconOnly ? (
      <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class={icon} aria-label={sourceText} title={sourceText} data-i18n="aria-label" data-zh={sourceText} data-en={sourceTextEn} onclick="event.stopPropagation()">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M6.2 9.8a3.2 3.2 0 0 1 0-4.5l2-2a3.2 3.2 0 0 1 4.5 4.5l-1.15 1.15" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
          <path d="M9.8 6.2a3.2 3.2 0 0 1 0 4.5l-2 2a3.2 3.2 0 1 1-4.5-4.5L4.45 7.05" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
        </svg>
      </a>
    ) : (
      <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class={size === "md" || primaryOfficial ? "btn btn-secondary" : "btn btn-secondary btn-sm"} title={sourceText} data-i18n="title" data-zh={sourceText} data-en={sourceTextEn}>
        <T zh={sourceText} en={sourceTextEn} />
        <span aria-hidden="true">↗</span>
      </a>
    )
  )}
</span>
