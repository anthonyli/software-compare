<div class="lang-switch" data-lang-switch>
  <span class="sr-only">
    <span class="t-zh">语言</span>
    <span class="t-en">Language</span>
  </span>
  <button
    type="button"
    class="lang-btn"
    data-lang="zh-CN"
    lang="zh-CN"
    aria-pressed="true"
  >
    中文
  </button>
  <button type="button" class="lang-btn" data-lang="en" lang="en" aria-pressed="false">
    EN
  </button>
</div>
