---
// SPDX-License-Identifier: Apache-2.0
import { categoryMonograms } from "../config";
import { ui } from "../i18n";
import T from "./T.astro";

type Cat = { slug: string; name: string; nameEn?: string; href: string; count: number };
type Group = { id: string; name: string; nameEn?: string; cats: Cat[] };

interface Props {
  groups: Group[];
}
const { groups } = Astro.props;
---

<div class="cat-menu" data-cat-menu>
  <button
    type="button"
    class="cat-menu-btn"
    data-cat-btn
    aria-expanded="false"
    aria-haspopup="true"
    aria-controls="cat-menu-panel"
  >
    <T zh={ui.zh.categories} en={ui.en.categories} />
    <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
      <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </button>
  <div
    class="cat-menu-panel"
    id="cat-menu-panel"
    data-cat-panel
    hidden
    role="menu"
    aria-label={ui.zh.allCategories}
    data-i18n="aria-label"
    data-zh={ui.zh.allCategories}
    data-en={ui.en.allCategories}
  >
    <div class="cat-menu-grid">
      {groups.map((g) => (
        <div>
          <div class="cat-menu-group-name">
            <T zh={g.name} en={g.nameEn || g.name} />
          </div>
          {g.cats.map((c) => (
            <a href={c.href} class="cat-menu-link" role="menuitem">
              <span>
                {categoryMonograms[c.slug] ? `${categoryMonograms[c.slug]}  ` : ""}
                <T zh={c.name} en={c.nameEn || c.name} />
              </span>
              <span>{c.count}</span>
            </a>
          ))}
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  const root = document.querySelector("[data-cat-menu]") as HTMLElement | null;
  if (root) {
    const btn = root.querySelector("[data-cat-btn]") as HTMLButtonElement;
    const panel = root.querySelector("[data-cat-panel]") as HTMLElement;
    const fitViewport = () => {
      if (panel.hidden) return;
      const viewport = window.visualViewport;
      const bottom = viewport ? viewport.offsetTop + viewport.height : window.innerHeight;
      panel.style.setProperty("--cat-menu-available-height", `${Math.max(0, bottom - panel.getBoundingClientRect().top - 16)}px`);
    };
    const close = () => {
      panel.hidden = true;
      btn.setAttribute("aria-expanded", "false");
    };
    const open = () => {
      panel.hidden = false;
      btn.setAttribute("aria-expanded", "true");
      fitViewport();
    };
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      if (panel.hidden) open();
      else close();
    });
    window.addEventListener("resize", fitViewport);
    window.visualViewport?.addEventListener("resize", fitViewport);
    document.addEventListener("focusin", (e) => {
      if (!root.contains(e.target as Node)) close();
    });
    root.addEventListener("keydown", (e) => {
      const links = Array.from(panel.querySelectorAll<HTMLAnchorElement>("a"));
      if (!["ArrowDown", "ArrowUp", "Home", "End"].includes(e.key)) return;
      if (panel.hidden && e.target !== btn) return;
      e.preventDefault();
      if (panel.hidden) open();
      const index = links.indexOf(document.activeElement as HTMLAnchorElement);
      const next = e.key === "Home" ? 0 : e.key === "End" ? links.length - 1
        : e.key === "ArrowDown" ? (index + 1) % links.length
        : (index <= 0 ? links.length - 1 : index - 1);
      links[next]?.focus();
    });
    document.addEventListener("click", (e) => {
      if (!root.contains(e.target as Node)) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !panel.hidden) {
        close();
        btn.focus();
      }
    });
  }
</script>
