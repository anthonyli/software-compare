---
// SPDX-License-Identifier: Apache-2.0
import sources from "../lib/product-logo-sources.json";

interface Props {
  id: string;
  size?: 32 | 40 | 64;
  reserve?: boolean;
}

const { id, size = 32, reserve = false } = Astro.props;
const src = /^[a-z0-9-]+$/.test(id) && Object.hasOwn(sources, id)
  ? `/product-logos/${id}.webp`
  : null;
---
{(src || reserve) && <span
  class="product-logo"
  data-product-logo={src ? "verified" : "placeholder"}
  aria-hidden="true"
  style={`--product-logo-size: ${size}px`}
>
  {src && <img src={src} alt="" width={size} height={size} loading={size === 64 ? "eager" : "lazy"} decoding="async" />}
</span>}

<style>
  .product-logo {
    display: inline-grid;
    width: var(--product-logo-size);
    height: var(--product-logo-size);
    flex: none;
    place-items: center;
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
