---
import T from './T.astro';
const { slug } = Astro.props;
const isAi = ['ai-assistants', 'ai-coding', 'ai-image-workflows'].includes(slug);
---
{isAi && <p class="mt-4 text-sm text-muted" data-ai-comparison-guide><T zh="直接比较下表中的工具能力与限制。未知不等于不支持；本表依据官方文档，不是实测排名。价格、额度、模型与数据政策请以链接中的当前官方说明为准。" en="Compare capabilities and limits in the table below. Unknown does not mean unsupported. This is a documentation comparison, not a benchmark. Check current official sources for pricing, quotas, models and data policies."/></p>}
